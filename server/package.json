{
  "name": "kengansocial-server",
  "version": "1.0.0",
  "description": "KenganSocial v2 Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx watch server.js",
