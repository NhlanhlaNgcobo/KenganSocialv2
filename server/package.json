    "@remotion/bundler": "^4.0.427",
    "@remotion/captions": "^4.0.427",
    "@remotion/media-utils": "^4.0.427",
    "@remotion/renderer": "^4.0.427",
    "axios": "^1.13.6",
    "bullmq": "^5.71.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "fluent-ffmpeg": "^2.1.3",
