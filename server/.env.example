# Copy to server/.env on the deployment host. Supply real values securely; never commit .env.
NODE_ENV=production
PORT=5000
CLIENT_URL=
FRONTEND_URL=
SERVER_URL=
CORS_EXTRA_ORIGINS=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# External VPS only: absolute path to a mounted service-account JSON file.
# On Google Cloud prefer the VM service identity.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Generate once, back it up securely, and retain it across deployments.
TOKEN_ENCRYPTION_KEY=
STORAGE_DRIVER=firebase
# Compose supplies PYTHON_API_URL, REDIS_URL and TMPDIR.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_FREE_FALLBACK=off
# New checkout uses Payfast. Keep sandbox until the acceptance tests pass.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Keep existing Paystack credentials only while servicing legacy subscriptions.
PAYSTACK_SECRET_KEY=

# AI editing runs in a separate worker (npm run worker:ai-edit; docker-compose "ai-worker").
# Outside production the API also runs it in-process; set to off when you start the worker yourself.
# AI_EDIT_INLINE_WORKER=off

# Clips and Repurpose: let users paste a YouTube link (downloaded with yt-dlp) as well as upload.
# Users confirm they own the video or have permission. Set to anything but "on" to hide it.
YOUTUBE_LINK_IMPORT=on

# Optional AI features (server/src/config/ai-features.ts). The core AI (clip finding, captions, hooks,
# AI Writer text) always runs; switched-off features use their non-AI versions. Launch setting below:
# cloud transcription only (keeps long clip videos quick). Empty = none, "all" = everything, or list:
# lyricsAi,aiImages,voiceover,aiMusic,cloudTranscription,trendingSearch,dmDrafts,styleLearning,websiteAi,thumbnailHeadlines,storyboardAi
LAUNCH_AI_FEATURES=cloudTranscription
