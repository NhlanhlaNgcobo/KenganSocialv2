# KenganSocial free beta (docs/KenganSocial_Going_Live.pdf, Part A) on one small free server.
# Add these to server/.env on the beta server, on top of the usual settings in server/.env.example
# (Firebase, TOKEN_ENCRYPTION_KEY, FREE_CLIP_SECRET, SERVER_URL, CLIENT_URL, FRONTEND_URL).
# No paid keys: leave OPENROUTER_API_KEY, OPENAI_API_KEY, ELEVENLABS_API_KEY, TREBLO_API_KEY,
# PERPLEXITY_API_KEY and the Payfast keys empty.

NODE_ENV=production

# Every new or free workspace gets the beta plan: Creator Pro features with beta-sized limits
# (videos up to 15 min, 3 clip projects, 10 exports, 60 AI credits a month).
BETA_ACCESS=on
BETA_PLAN=creator
# The beta replaces the 7-day trial.
TRIAL_DAYS=0

# Optional AI features: all off (empty). Long videos are transcribed on our own server.
LAUNCH_AI_FEATURES=
CLIP_TRANSCRIBE=local

# Free AI for captions, hooks, titles and AI Edit decisions: Gemini's free tier (Google AI
# Studio key) first, then the built-in free fallback (Pollinations) when Gemini is busy.
GEMINI_API_KEY=
AI_FREE_FALLBACK=on
# Free images for carousels (free account at enter.pollinations.ai).
POLLINATIONS_API_KEY=

# Stock videos in the editor and lyric video backgrounds (free key at pexels.com/api).
PEXELS_API_KEY=

# Downloading from YouTube breaks YouTube's terms: keep off; users upload their own files.
YOUTUBE_LINK_IMPORT=

# Media on the server's disk (the free server's boot volume). Move to cloud storage when you grow.
STORAGE_DRIVER=local

# Free clips for visitors: keep it small on a 2-core server (each takes a few minutes).
FREE_CLIP_DAILY_CAP=10
