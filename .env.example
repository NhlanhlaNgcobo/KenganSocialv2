# ===========================
# KenganSocial v2 — Environment Variables
# ===========================
# Copy this to .env and fill in your values

# ----- Server -----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ----- Firebase Admin (Backend) -----
# Option 1: Service account JSON file path
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Individual credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ----- Firebase Client (Frontend) -----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----- API URL -----
VITE_API_URL=http://localhost:5000/api

# ----- AI Services -----
# At least one of OPENROUTER_API_KEY or GEMINI_API_KEY is needed for the clip finder,
# Repurpose and launch-video storyboards. OpenRouter is tried first when set (faster).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# AI_JSON_MODEL=anthropic/claude-haiku-4.5
# AI_JSON_PROVIDERS=openrouter,gemini

# ----- Queue and security -----
REDIS_URL=redis://localhost:6379
# 64 hex characters (generate with: openssl rand -hex 32). Encrypts social account tokens at rest
# and signs OAuth sign-in state. Never change it once accounts are connected.
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# ----- Python video service -----
PYTHON_API_URL=http://localhost:8000

# --- python-service/.env: YouTube & social link imports (all optional) ---
# YouTube blocks many downloads from cloud servers ("confirm you're not a bot"). Without these,
# users fall back to uploading the file. With them, link imports succeed far more often.
# YTDLP_PROXY=http://user:pass@residential-proxy-host:port
# YTDLP_COOKIES_FILE=/secrets/youtube-cookies.txt     (cookies.txt from a dedicated signed-in account)
# YTDLP_PLAYER_CLIENTS=default,tv,web_safari,mweb
# MAX_REFERENCE_SECONDS=600                           (AI Edit style reference length cap)

# ----- Social account connections (OAuth apps) -----
# KenganSocial supports Instagram, Facebook, TikTok and YouTube.
# Each platform's redirect URI is ${SERVER_URL}/api/connections/<platform>/callback
# (instagram, facebook, tiktok, youtube). One Meta app (FACEBOOK_APP_ID) serves Instagram and Facebook Pages.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Verifies Meta webhook signatures and data-deletion requests; falls back to FACEBOOK_APP_SECRET.
# Without it, production refuses all Meta webhooks.
META_APP_SECRET=
# Any long random string you choose; enter the same value as the "Verify token" in the Meta app's
# Webhooks settings. Webhook callback URL: ${SERVER_URL}/api/webhooks/meta
META_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
# Also verifies TikTok webhooks. Webhook callback URL (TikTok developer portal): ${SERVER_URL}/api/webhooks/tiktok
TIKTOK_CLIENT_SECRET=
# Default: user.info.basic,video.publish (direct posting only)
# TIKTOK_SCOPES=
# TikTok privacy is chosen on each post in the scheduler (TikTok's rules allow no default).
# Unaudited TikTok apps can only post "Only me".
# Meta Graph API version (default v25.0, supported until July 2028). Meta retires versions after about two years.
# META_GRAPH_VERSION=v25.0

# ----- Stock media (optional) -----
# Free key from pexels.com/api enables video b-roll in the editor. Images and music work without it.
# PEXELS_API_KEY=

# ----- Paystack -----
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_WEBHOOK_URL=

# ----- Local testing (optional) -----
# Treat every workspace as this plan (starter | nano | creator | agency).
# Ignored unless NODE_ENV=development, so it cannot unlock paid features in production.
# DEV_PLAN_OVERRIDE=creator

# ----- AI models (optional) -----
# Defaults to Google's rolling alias; pin a version if you need stable output.
# GEMINI_MODEL=gemini-flash-latest

# ----- Video editor export (optional) -----
# Defaults to `ffmpeg` / `ffprobe` on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Font file for burned-in text; defaults to system Arial (Windows) or DejaVu (Linux).
# EDITOR_FONT_FILE=

# ----- Lyric analyzer (optional, uses OPENROUTER_API_KEY above) -----
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_AUDIO_MODEL=google/gemini-3.8-flash

# ----- Audiomack guide tracks (optional) -----
# Data API consumer credentials, issued by Audiomack on request. Stream-only; never exported.
# AUDIOMACK_CONSUMER_KEY=
# AUDIOMACK_CONSUMER_SECRET=

# ----- Media storage -----
# firebase (default) | s3 (Backblaze B2, Cloudflare R2, any S3-compatible) | local (dev: ./uploads)
# STORAGE_DRIVER=firebase
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL for objects, e.g. https://f004.backblazeb2.com/file/<bucket> or https://pub-xxxx.r2.dev
# S3_PUBLIC_URL=

# ----- Marketing: AI images for carousels (optional) -----
# Free: Pollinations (open source, MIT; free account at https://enter.pollinations.ai/keys).
# Runs open models such as FLUX.2 klein 4B (Apache-2.0) on free daily credit.
# POLLINATIONS_API_KEY=
# Paid "best quality" tier uses OPENROUTER_API_KEY above (GPT Image 2.5 Flare by default).
# Override the model per tier without code changes:
# IMAGE_MODEL_BEST=openai/gpt-image-2.5-flare
# IMAGE_MODEL_FAST=google/gemini-nano-banana-2.1
# POLLINATIONS_MODEL_BEST=openai/gpt-image-2
# POLLINATIONS_MODEL_FAST=black-forest-labs/flux.2-klein-4b

# Import a video from a YouTube link (yt-dlp). Off unless "on". YouTube's API policies restrict
# downloading YouTube content and TikTok rejects apps that copy content from other platforms:
# keep it off while applying for API access unless you have legal sign-off.
YOUTUBE_LINK_IMPORT=
