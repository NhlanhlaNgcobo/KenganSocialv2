rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(workspaceId) {
      return request.auth != null && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }
    function member(workspaceId) {
      return request.auth != null && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }
    function writer(workspaceId) {
      return owner(workspaceId) || (member(workspaceId) && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role in ['admin', 'editor']);
    }
    match /{workspaceId}/media/{allPaths=**} {
      allow read: if owner(workspaceId) || member(workspaceId);
      allow create, update: if writer(workspaceId) && request.resource.size < 50 * 1024 * 1024;
      allow delete: if writer(workspaceId);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
