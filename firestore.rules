rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The web app reads and writes everything through the API (server/, Admin SDK, which these
    // rules do not apply to), so the browser can't write anything: no client can read encrypted
    // social tokens, change its plan, rewrite its consent records, or reach another workspace's data.

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Consent audit trail (POPIA), written by the server (POST /api/auth/consent) with time and IP.
      match /consents/{consentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else (workspaces, connections, inbox, schedules, jobs, deletion requests)
    // is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
