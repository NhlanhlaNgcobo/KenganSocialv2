FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccount.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
PORT=8000

# Local-first providers
TRANSCRIPTION_PROVIDER=local
CLIP_ANALYSIS_PROVIDER=local
ENABLE_PEXELS=false

# Optional tuning
WHISPER_MODEL_NANO=base
WHISPER_MODEL_CREATOR=small
WHISPER_MODEL_AGENCY=medium
WHISPER_COMPUTE_TYPE=int8
SCENEDETECT_THRESHOLD=27
MIN_KEEP_SEGMENT_SEC=2.5
BLACK_FRAME_MIN_DURATION=0.35
SILENCE_MIN_DURATION=0.75

# Optional paid / cloud fallbacks
ASSEMBLYAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=serviceAccount.json
PEXELS_API_KEY=

# Folder for working files. Must be the same disk the API uses (docker-compose sets it to the shared volume).
# VIDEO_TMP_DIR=/shared/tmp
