# Firebase: a key file (FIREBASE_SERVICE_ACCOUNT_PATH), or FIREBASE_PROJECT_ID +
# FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY, or neither on a Google Cloud VM (its service
# account is used; set FIREBASE_PROJECT_ID).
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccount.json
FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
PORT=8000

# Local-first providers
TRANSCRIPTION_PROVIDER=local
CLIP_ANALYSIS_PROVIDER=local

# Optional tuning
WHISPER_MODEL_NANO=base
WHISPER_MODEL_CREATOR=small
WHISPER_MODEL_AGENCY=medium
WHISPER_COMPUTE_TYPE=int8
SCENEDETECT_THRESHOLD=27
MIN_KEEP_SEGMENT_SEC=2.5
BLACK_FRAME_MIN_DURATION=0.35
SILENCE_MIN_DURATION=0.75

# Optional paid / cloud fallbacks
ASSEMBLYAI_API_KEY=

# Folder for working files. Must be the same disk the API uses (docker-compose sets it to the shared volume).
# VIDEO_TMP_DIR=/shared

# Transcription/analysis jobs run at once (default 3). Set 1 on a dedicated 4-vCPU worker machine.
# MAX_CONCURRENT_JOBS=3

# Longest video accepted from a link import, and from an AI Edit style reference (seconds).
# MAX_IMPORT_SECONDS=
# MAX_REFERENCE_SECONDS=600
# YouTube link imports from cloud servers (see the root .env.example):
# YTDLP_PROXY=
# YTDLP_COOKIES_FILE=
# YTDLP_PLAYER_CLIENTS=
